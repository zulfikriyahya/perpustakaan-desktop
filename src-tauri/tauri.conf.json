{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perpustakaan MTsN 1 Pandeglang",
  "version": "0.1.0",
  "identifier": "com.zulfikriyahya.perpustakaan-mtsn1pandeglang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Perpustakaan MTsN 1 Pandeglang",
        "url": "https://perpustakaan.mtsn1pandeglang.sch.id/dashboard/sirkulasi",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xserver-xorg",
          "xinit",
          "x11-xserver-utils"
        ],
        "files": {},
        "postInstallScript": "debian/postinst"
      }
    },
    "category": "Education",
    "shortDescription": "Aplikasi akses sirkulasi perpustakaan",
    "longDescription": "Aplikasi desktop untuk mengakses sistem sirkulasi perpustakaan MTsN 1 Pandeglang secara langsung."
  }
}
